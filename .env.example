# NovaCart — environment configuration
# Copy this file to ".env" and fill in the values. Never commit ".env".

PORT=5000
NODE_ENV=development

# Public origin of the site, used to build password-reset links.
# REQUIRED in production: without it the server refuses to start, because
# links would otherwise be built from the request Host header, which an
# attacker can forge to steal reset tokens.
APP_URL=http://localhost:5000

# ---------------------------------------------------------------
# MongoDB connection string
# ---------------------------------------------------------------
# Local MongoDB (default install):
MONGODB_URI=mongodb://127.0.0.1:27017/novacart
#
# MongoDB Atlas (cloud) — replace user, password and cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/novacart?retryWrites=true&w=majority

# ---------------------------------------------------------------
# Sessions (JWT)
# ---------------------------------------------------------------
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=30d
JWT_SESSION_EXPIRES_IN=1d
JWT_COOKIE_DAYS=30

# ---------------------------------------------------------------
# Admin account — seeded by: npm run seed:admin
# This email is the ONLY one that receives the admin role.
# ---------------------------------------------------------------
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# --- Mail (SMTP) ---
# Leave SMTP_HOST empty for console mode: emails are logged to the server
# console, and password-reset links appear in the browser (development only).
# Gmail example: host smtp.gmail.com, port 465, SMTP_SECURE=true,
#   SMTP_USER=you@gmail.com, SMTP_PASS=an App Password (needs 2FA, see
#   myaccount.google.com/apppasswords) - NOT your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NovaCart <no-reply@novacart.example>"
# Development helper: true = use a throwaway Ethereal test inbox (a real SMTP
# round trip; preview URLs are logged) without needing any credentials.
MAIL_ETHEREAL=false
# Contact-form messages are delivered here (falls back to ADMIN_EMAIL).
CONTACT_TO=
