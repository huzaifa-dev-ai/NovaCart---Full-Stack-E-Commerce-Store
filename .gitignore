# dependencies
node_modules/

# environment — never commit real credentials
.env

# logs
*.log
npm-debug.log*

# OS / editor noise
Thumbs.db
.DS_Store

# local database files (if you run mongod with --dbpath ./data)
data/

# scratch
tests/*.output
*.tmp.js
scratchpad/

# local TLS certificates (never commit private keys)
certs/
# Headless-Chrome user profiles left by the browser-driven UI tests.
# Regenerated on demand and hundreds of megabytes each.
chrome-profile-*/
